      "printedPage": 127,
      "section": "课文2：听后/读后练习",
      "provenance": "textbook"
    },
    "referenceAnswer": {
      "zh": "她想去图书馆看中文报纸。",
      "vi": "Cô ấy muốn đến thư viện đọc báo tiếng Trung."
    },
    "provenance": "editorial non-unique reference"
  },
  {
    "lesson": 14,
    "activityId": "hsk3-fltrp-2026:l14:activity:text2-reading",
    "fieldId": "hsk3-fltrp-2026:l14:field:text2-question4",
