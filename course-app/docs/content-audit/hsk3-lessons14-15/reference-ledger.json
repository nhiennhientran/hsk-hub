      "printedPage": 125,
      "section": "课文1：听后/读后练习",
      "provenance": "textbook"
    },
    "referenceAnswer": {
      "zh": "他把书名写在纸上。",
      "vi": "Anh viết tên sách lên giấy."
    },
    "provenance": "editorial non-unique reference"
  },
  {
    "lesson": 14,
    "activityId": "hsk3-fltrp-2026:l14:activity:text2-reading",
    "fieldId": "hsk3-fltrp-2026:l14:field:text2-question3",
