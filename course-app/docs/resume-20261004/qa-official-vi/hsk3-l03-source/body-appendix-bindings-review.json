{
  "level": 3,
  "lesson": 3,
  "items": [
    {
      "bodySourceId": "hsk3-official-body:l03:text1:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/0",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 32,
      "printedPage": 20,
      "printedRoleZh": "王一雪",
      "zhPrinted": "小雪的初中离家有点儿远，咱们换一个近点儿的房子吧。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-1-line-01"
      ],
      "sourceRecordSHA256": "8922253144888f9c6d95ba32b123493282548b6ed4e6e345f10b7c15f260deab",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text1:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/1",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 32,
      "printedPage": 20,
      "printedRoleZh": "刘明",
      "zhPrinted": "好啊，我上网看看。你觉得这个小区怎么样？",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-1-line-02"
      ],
      "sourceRecordSHA256": "0ca5ed480208dcd3fa00eeccfc3cc670809fad76192ba2a440537386ae544a86",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text1:line03",
      "sourcePointer": "/bodyChineseOnlyTexts/2",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 32,
      "printedPage": 20,
      "printedRoleZh": "王一雪",
      "zhPrinted": "环境挺好的，离地铁站还不远。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-1-line-03"
      ],
      "sourceRecordSHA256": "81f0ad6cce0b1f7f8a5065520cfb90de39de925451b2fe81eb6edd46cdb8f9e8",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text1:line04",
      "sourcePointer": "/bodyChineseOnlyTexts/3",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 32,
      "printedPage": 20,
      "printedRoleZh": "刘明",
      "zhPrinted": "房子里面也不错，空调和洗衣机都是新的。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-1-line-04"
      ],
      "sourceRecordSHA256": "f8bd1d9938ef37391061c8c239fff174f35a17051fee3138cf98b4903b15e13d",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text1:line05",
      "sourcePointer": "/bodyChineseOnlyTexts/4",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 32,
      "printedPage": 20,
      "printedRoleZh": "王一雪",
      "zhPrinted": "是不错，但是我不喜欢住一层。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-1-line-05"
      ],
      "sourceRecordSHA256": "fb72800d41a3ade41655168ccebdd0a5e8b672d354cd673409291308d217feb1",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text1:line06",
      "sourcePointer": "/bodyChineseOnlyTexts/5",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 32,
      "printedPage": 20,
      "printedRoleZh": "刘明",
      "zhPrinted": "这个一层带一个小花园，我觉得咱们可以去看看。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-1-line-06"
      ],
      "sourceRecordSHA256": "1ef5f09f96c4bbe4531056e67bcfdd1954dbee788c4d87baecc15b2efd2facdf",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/6",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "王一雪",
      "zhPrinted": "我今天早上来的时候，灯还开着。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-2-line-01"
      ],
      "sourceRecordSHA256": "47723b5fb45c54ad77a74792a03b38eecce0ee094d8614e8d11c69762510479f",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/7",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "刘明",
      "zhPrinted": "我这几天忙坏了，可能走的时候忘关了。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-2-line-02"
      ],
      "sourceRecordSHA256": "cb937b97262a5f5241e35071ffd6661c62f011970a1cfe47609f80ea60e10198",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line03",
      "sourcePointer": "/bodyChineseOnlyTexts/8",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "王一雪",
      "zhPrinted": "冰箱不能用，这些吃的东西放在哪儿？",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-2-line-03"
      ],
      "sourceRecordSHA256": "fac1fc071c4cbba97cab9277fd2001638cbfbbeb5a50ce88b3378508a8926c3c",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line04",
      "sourcePointer": "/bodyChineseOnlyTexts/9",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "刘明",
      "zhPrinted": "不可能吧？冰箱是新买的，我来看看。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-2-line-04"
      ],
      "sourceRecordSHA256": "e4561a51c5f3ceae0c2ccfe2380da823d77729b9bd6f2b126a3dfedf426d12bf",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line05",
      "sourcePointer": "/bodyChineseOnlyTexts/10",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "王一雪",
      "zhPrinted": "洗衣机也坏了吗？",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-2-line-05"
      ],
      "sourceRecordSHA256": "fee73eaec72677790b3f21692fa035018979af91e30fafbd1f5ee1b809593820",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line06",
      "sourcePointer": "/bodyChineseOnlyTexts/11",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "刘明",
      "zhPrinted": "没坏，但是卫生间没打扫好，还不能洗衣服。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p184:appendix-text-2-line-06"
      ],
      "sourceRecordSHA256": "eb52af29d8129cbb5ce1764239401c42554f96f93a8ec6018d6bf7740f7e30f2",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text2:line07",
      "sourcePointer": "/bodyChineseOnlyTexts/12",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 34,
      "printedPage": 22,
      "printedRoleZh": "王一雪",
      "zhPrinted": "星期天我们真的能搬家吗？",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-2-line-07"
      ],
      "sourceRecordSHA256": "f316add5f944c403949ab7ad31927de0ce50b4c66cf09960a2778a589b4bb80f",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/13",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "王一雪",
      "zhPrinted": "这个月花了不少钱。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-01"
      ],
      "sourceRecordSHA256": "0e12834040c56804fb41d05e46e6d5838d3c998557f4547205ca07e59f625ffb",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/14",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "刘明",
      "zhPrinted": "是的，我们买了很多搬家时要用的东西。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-02"
      ],
      "sourceRecordSHA256": "ffca3edb61867a7e7ef0e030f9c21425a1ce8cbd190e0950483a81d88e502971",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line03",
      "sourcePointer": "/bodyChineseOnlyTexts/15",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "王一雪",
      "zhPrinted": "咱们办张信用卡吧，花的钱可以慢慢还。听说中国银行的服务不错，办了信用卡买东西还能便宜。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-03"
      ],
      "sourceRecordSHA256": "288cf778f415296a7527106844c504adba0fdf43b18820cbc4b2407efec406db",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line04",
      "sourcePointer": "/bodyChineseOnlyTexts/16",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "刘明",
      "zhPrinted": "好啊！中国银行很近，走路几分钟就能到。咱们什么时候去？",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-04"
      ],
      "sourceRecordSHA256": "0335d42d9d89780bfb3148abf8bba4ccbe0432c0e3cd2793f81dfee57e61248e",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line05",
      "sourcePointer": "/bodyChineseOnlyTexts/17",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "王一雪",
      "zhPrinted": "今天下午？",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-05"
      ],
      "sourceRecordSHA256": "f77ed47df596f4ca1dc77c87195a7fe9da6b88f8928abc0a0cdf4e505ca723ae",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line06",
      "sourcePointer": "/bodyChineseOnlyTexts/18",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "刘明",
      "zhPrinted": "我下午要去医院，很晚才能回来。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-06"
      ],
      "sourceRecordSHA256": "00451c6ac42d4e7e22a09cdaa60cc19503a90ed143e59626c0f66f6fc9600a30",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text3:line07",
      "sourcePointer": "/bodyChineseOnlyTexts/19",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 35,
      "printedPage": 23,
      "printedRoleZh": "王一雪",
      "zhPrinted": "那我下午自己去吧。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-3-line-07"
      ],
      "sourceRecordSHA256": "cce1fe5a441be89db066ff499cc7180b6eea61ed4270cbabc9b45e920a2af366",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text4:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/20",
      "verdict": "accepted",
      "sourceBodyKind": "role-labelled-whole-paragraph",
      "pdfPage": 37,
      "printedPage": 25,
      "printedRoleZh": "刘明",
      "zhPrinted": "我觉得这个星期就能搬家。我明天去买一些纸箱，很快就能准备好。搬家那天，我想请几位朋友来帮忙，最多一天就能搬完。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-4-line-01"
      ],
      "sourceRecordSHA256": "8338e08c2e0e7ade4df5223883560fba10352c3fae12ca992ed8c7080a7dab66",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l03:text4:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/21",
      "verdict": "accepted",
      "sourceBodyKind": "role-labelled-whole-paragraph",
      "pdfPage": 37,
      "printedPage": 25,
      "printedRoleZh": "王一雪",
      "zhPrinted": "我觉得下个月才能搬家。这周开始准备，下周去打扫新家，这么多事情最少需要两个星期才能做完。搬家那天，我们应该找一家搬家公司。",
      "appendixSourceIds": [
        "hsk3-official-vi:l03:p185:appendix-text-4-line-02"
      ],
      "sourceRecordSHA256": "8cb9cd175e55681fb3251ee44d4340b744e29ad53dca1cdd5a490f3f0cdd2a11",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    }
  ]
}
