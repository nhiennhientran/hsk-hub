{
  "level": 3,
  "lesson": 1,
  "items": [
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/0",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "刘明",
      "zhPrinted": "这是杨同乐吗？他怎么跟白家月在一起？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role01"
      ],
      "sourceRecordSHA256": "8483096e1bddfbe7f2768726537905d1170ec3e2345dbae76204ce200d2682dd",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/1",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "王一雪",
      "zhPrinted": "他不是杨同乐，他叫李文，是白家月的好朋友。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role02"
      ],
      "sourceRecordSHA256": "5bbd191a17836fca34954743e60920a04f6fe6035a57090e3f8e6ae30d59170f",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line03",
      "sourcePointer": "/bodyChineseOnlyTexts/2",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "刘明",
      "zhPrinted": "我还以为是同乐呢，他们看上去有点儿像。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role03"
      ],
      "sourceRecordSHA256": "94437eff5f98a7d71207bc766ff30ae05c890aad2ceec672c05cb889f7ddc295",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line04",
      "sourcePointer": "/bodyChineseOnlyTexts/3",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "王一雪",
      "zhPrinted": "是长得有点儿像，但是他比同乐高，身高有一米八。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role04"
      ],
      "sourceRecordSHA256": "0938cd9be9ddf1899c437938b5db748c48fa08fc70b14f21e264c3822c0088f1",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line05",
      "sourcePointer": "/bodyChineseOnlyTexts/4",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "刘明",
      "zhPrinted": "看起来也比同乐瘦一点儿。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role05"
      ],
      "sourceRecordSHA256": "9692527fa8e6ee66ac719f6045d83bdcf01adc7a44df42dd5625df9638ab4e56",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line06",
      "sourcePointer": "/bodyChineseOnlyTexts/5",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "王一雪",
      "zhPrinted": "下个星期家月和李文要来北京，我去机场接他们。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role06"
      ],
      "sourceRecordSHA256": "3b6f3e0aad29830649c303e4383a2823af9abb8ca78bf3b4bfb95eb1643420e3",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text1:line07",
      "sourcePointer": "/bodyChineseOnlyTexts/6",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 14,
      "printedPage": 2,
      "printedRoleZh": "刘明",
      "zhPrinted": "他们哪天到北京？我跟你一起去机场接他们吧。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text1-role07"
      ],
      "sourceRecordSHA256": "e3d15f23e79d91641b2fda0a442a83ba5aca5ac63ffcc55af8f487eddac0bc41",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text2:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/7",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 16,
      "printedPage": 4,
      "printedRoleZh": "白家月",
      "zhPrinted": "我的行李怎么还没出来？是不是丢了？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text2-role01"
      ],
      "sourceRecordSHA256": "2258ba1730a7c9b41b05102c226ee36196fef0b182a4c6fc44fd5cb07fcfb07e",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text2:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/8",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 16,
      "printedPage": 4,
      "printedRoleZh": "李文",
      "zhPrinted": "你的行李箱是什么样的？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text2-role02"
      ],
      "sourceRecordSHA256": "e468602ed5bf45f47be8f4503480c87bc31d3084c36d022cd589119479de420a",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text2:line03",
      "sourcePointer": "/bodyChineseOnlyTexts/9",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 16,
      "printedPage": 4,
      "printedRoleZh": "白家月",
      "zhPrinted": "是一个黑色的箱子，上面写着我的名字和电话号码。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text2-role03"
      ],
      "sourceRecordSHA256": "f41ed87589961d18254885ce0dafccd3285199ca80034d0fbb213d4923f4e30f",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text2:line04",
      "sourcePointer": "/bodyChineseOnlyTexts/10",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 16,
      "printedPage": 4,
      "printedRoleZh": "李文",
      "zhPrinted": "我好像在哪儿看到过这个箱子，是不是有人拿错了？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text2-role04"
      ],
      "sourceRecordSHA256": "1f6845f1356bb166f00c65e2a1d789bbc1d2f156e012a96366c667a6af45aadb",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text2:line05",
      "sourcePointer": "/bodyChineseOnlyTexts/11",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 16,
      "printedPage": 4,
      "printedRoleZh": "白家月",
      "zhPrinted": "我们快找谁问一下吧，箱子里有不少重要的东西。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text2-role05"
      ],
      "sourceRecordSHA256": "b4f52dc49134b66b1b428c5bd4d5cb767c13226e4998eaedab11f87fa0a9ed6f",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text2:line06",
      "sourcePointer": "/bodyChineseOnlyTexts/12",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 16,
      "printedPage": 4,
      "printedRoleZh": "李文",
      "zhPrinted": "别着急，我们拿着护照和机票，去服务台问问吧。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text2-role06"
      ],
      "sourceRecordSHA256": "17d1fb6460c7d43b8cff9f4a2f1a6eb795ee13a7a7e150701c4334d07211a2c6",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text3:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/13",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 18,
      "printedPage": 6,
      "printedRoleZh": "刘明",
      "zhPrinted": "飞机早就到了，你看见白家月他们了吗？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text3-role01"
      ],
      "sourceRecordSHA256": "8c7fbceda62298ddd1fed5cf1f1ad7744690a05b4855ba25011ac1280825d238",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text3:line02",
      "sourcePointer": "/bodyChineseOnlyTexts/14",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 18,
      "printedPage": 6,
      "printedRoleZh": "王一雪",
      "zhPrinted": "没有，他们应该快出来了。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text3-role02"
      ],
      "sourceRecordSHA256": "f14cadd01250aa03578fc9dcaab8a045b2adef68ff5e433b6487e7719d9d55a4",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text3:line03",
      "sourcePointer": "/bodyChineseOnlyTexts/15",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 18,
      "printedPage": 6,
      "printedRoleZh": "刘明",
      "zhPrinted": "我们站到中间去吧，这样他们好找一些。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text3-role03"
      ],
      "sourceRecordSHA256": "9755bc883b6cf016b7cfc07b6d9d2b545c4fafda79aa1880247d145cc1f6f6b3",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text3:line04",
      "sourcePointer": "/bodyChineseOnlyTexts/16",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 18,
      "printedPage": 6,
      "printedRoleZh": "王一雪",
      "zhPrinted": "你看那个高个子的人是李文吗？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text3-role04"
      ],
      "sourceRecordSHA256": "ec1a0ae81860ae81a385e617fee50bb2f2d430b98d82ec3970d1bdcf5454f224",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text3:line05",
      "sourcePointer": "/bodyChineseOnlyTexts/17",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 18,
      "printedPage": 6,
      "printedRoleZh": "刘明",
      "zhPrinted": "你说的是哪个？那个穿着黑衣服的短头发的年轻人？",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text3-role05"
      ],
      "sourceRecordSHA256": "4aa9c45f2c4a261f4d7caefcae8b0cfba101f4ba373cedfcc4db0eba89a0f002",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text3:line06",
      "sourcePointer": "/bodyChineseOnlyTexts/18",
      "verdict": "accepted",
      "sourceBodyKind": "role-dialogue-line",
      "pdfPage": 18,
      "printedPage": 6,
      "printedRoleZh": "王一雪",
      "zhPrinted": "对，那个人就是李文！你看，家月在他后面呢。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text3-role06"
      ],
      "sourceRecordSHA256": "bb520e8b3cf2e47907a5953b800d9d0adec71d747cec6dbd181cf1625e09b243",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    },
    {
      "bodySourceId": "hsk3-official-body:l01:text4:line01",
      "sourcePointer": "/bodyChineseOnlyTexts/19",
      "verdict": "accepted",
      "sourceBodyKind": "whole-unlabelled-paragraph",
      "pdfPage": 19,
      "printedPage": 7,
      "printedRoleZh": null,
      "zhPrinted": "昨天我到北京了。虽然路上花了十几个小时，但是跟家月坐在一起，我觉得时间过得很快。到机场的时候，家月发现行李箱不见了，我带她去服务台，帮助她找到了行李箱。走出机场的时候，已经八点多了，我们一出来就看见了王老师的姐姐，她看起来比照片上年轻。晚上，一雪姐带我们去吃了一家很好吃的中国菜。",
      "appendixSourceIds": [
        "hsk3-official-vi:l01:p183:appendix-text4-whole-paragraph"
      ],
      "sourceRecordSHA256": "ceb0e6d111365fb7d64ef7638ee707a39e1b58d0f9127f1a154f69663486219f",
      "bodyVietnameseAbsent": true,
      "actualChineseAndAppendixRoleCorrespondenceVisuallyChecked": true,
      "websiteLinePartitionNotInferred": true
    }
  ]
}
