  "minimumHistoryContract": {
    "hsk1": "Immutable known raw grading authorities + per-logical-commit/per-slot frozen display VI fields; original answer indexes unchanged; draft/round capture survives reload.",
    "hsk23": "Existing full Question snapshots plus answers/score/profile; no whole-book user snapshot; preserve first/latest actually stored, not nonexistent middle history.",
    "unknownHistorical": "Keep raw values and missing-snapshot disclosure; no inferred textbook edition, canonical revision or source certification.",
    "assetsAndAsr": "Immutable historical refs and byte identities; distinct current display revision; no user backup copies of entire media/PDF/book."
  },
