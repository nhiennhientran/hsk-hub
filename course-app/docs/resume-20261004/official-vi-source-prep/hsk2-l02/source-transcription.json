    {
      "sourceId": "hsk2-official-vi:l02:p012:text1-line1",
      "printedPage": 12,
      "pdfPage": 26,
      "section": "text1-line1",
      "zhAnchor": "请问，这儿有到北京大学的公交车吗？",
      "viPrinted": "Xin hỏi, ở đây có xe buýt đi đến Đại học Bắc Kinh không?",
      "speakerZh": "白家月",
      "speakerVi": "Bạch Gia Nguyệt",
      "viFullPrinted": "Bạch Gia Nguyệt: Xin hỏi, ở đây có xe buýt đi đến Đại học Bắc Kinh không?",
      "status": "author-transcribed-awaiting-independent-source-review"
    },
    {
      "sourceId": "hsk2-official-vi:l02:p012:text1-line2",
      "printedPage": 12,
      "pdfPage": 26,
      "section": "text1-line2",
      "zhAnchor": "有，但车站有点儿远。",
      "viPrinted": "Có đấy, nhưng bến xe buýt hơi xa.",
      "speakerZh": "服务员",
      "speakerVi": "Nhân viên phục vụ",
      "viFullPrinted": "Nhân viên phục vụ: Có đấy, nhưng bến xe buýt hơi xa.",
      "status": "author-transcribed-awaiting-independent-source-review"
    },
    {
      "sourceId": "hsk2-official-vi:l02:p012:text1-line3",
      "printedPage": 12,
      "pdfPage": 26,
      "section": "text1-line3",
      "zhAnchor": "这儿好打车吗？",
      "viPrinted": "Ở đây gọi xe taxi có dễ không vậy?",
      "speakerZh": "白家月",
      "speakerVi": "Bạch Gia Nguyệt",
      "viFullPrinted": "Bạch Gia Nguyệt: Ở đây gọi xe taxi có dễ không vậy?",
      "status": "author-transcribed-awaiting-independent-source-review"
    },
