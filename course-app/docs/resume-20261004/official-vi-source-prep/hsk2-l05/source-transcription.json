      "printedParentheticalAnnotation": true,
      "zhContext": "我在外边呢，你出来（chūlái, ra đây）吧。（说话人在外边，听话人在里边）"
    },
    {
      "sourceId": "hsk2-official-vi:l05:p039:grammar1-rule2",
      "pdfPage": 53,
      "printedPage": 39,
      "section": "grammar1-rule2",
