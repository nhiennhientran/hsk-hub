  "lessons": [
    {
      "file": "course-app/content/hsk2/lesson-10.json",
      "sha256": "5e8b2f82916f6bce00f4d28d0b31f8caf347f813bee9e19408f0edf723130156",
      "id": "hsk2-fltrp-2026:l10",
      "source": {
        "startPdfPage": 99,
        "endPdfPage": 107,
        "startPrintedPage": 84,
        "endPrintedPage": 92
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l10:text1",
          "audioTrack": "10-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l10:text1:line1",
              "zh": "小明，你们明天开学，你准备好了吗？",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line2",
              "zh": "明天就开学啊？爸爸，我的书包你看见了吗？",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line3",
              "zh": "书包在门后面。",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line4",
              "zh": "书在哪儿呢？笔呢？",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line5",
              "zh": "书在床上，笔在桌子上。",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line6",
              "zh": "太好了！现在都准备好了。",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line7",
              "zh": "这次爸爸帮你，下次你自己准备，好不好？",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text1:line8",
              "zh": "好！",
              "source": {
                "pdfPage": 100,
                "printedPage": 85,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l10:text2",
          "audioTrack": "10-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l10:text2:line1",
              "zh": "小雪，你在做什么呢？",
              "source": {
                "pdfPage": 102,
                "printedPage": 87,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text2:line2",
              "zh": "明天考试，我在看书呢。",
              "source": {
                "pdfPage": 102,
                "printedPage": 87,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text2:line3",
              "zh": "这些词要好好看看。",
              "source": {
                "pdfPage": 102,
                "printedPage": 87,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text2:line4",
              "zh": "我看过了，意思也都懂了。",
              "source": {
                "pdfPage": 102,
                "printedPage": 87,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text2:line5",
              "zh": "你的本子呢？本子上做错的题也要看一看。",
              "source": {
                "pdfPage": 102,
                "printedPage": 87,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text2:line6",
              "zh": "妈妈，是您准备考试还是我准备考试？",
              "source": {
                "pdfPage": 102,
                "printedPage": 87,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l10:text3",
          "audioTrack": "10-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l10:text3:line1",
              "zh": "妈妈，我回来了！",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line2",
              "zh": "我买了奶茶，就在桌子上，自己去拿吧。",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line3",
              "zh": "谢谢妈妈！",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line4",
              "zh": "今天考试考得怎么样？",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line5",
              "zh": "我觉得比上次好。",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line6",
              "zh": "真不错！饭菜快要做好了，你叫弟弟一起去洗手吧。",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line7",
              "zh": "……",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line8",
              "zh": "妈妈，我是第一名，姐姐还没洗完呢。",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l10:text3:line9",
              "zh": "你洗得真快啊！",
              "source": {
                "pdfPage": 104,
                "printedPage": 89,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l10:text4",
          "audioTrack": "10-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l10:text4:line1",
              "zh": "快要开学了，爸爸帮弟弟准备书包、本子和笔。我就要考试了，妈妈让我看书、看做错的题。我们上学，爸爸、妈妈比我们还忙。我问他们：“是我和弟弟上学还是你们上学？”我问完，他们都笑了。",
              "source": {
                "pdfPage": 106,
                "printedPage": 91,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
      ],
