    {
      "file": "course-app/content/hsk2/lesson-12.json",
      "sha256": "c64d2e1bc3dac399f1737338e70474d8ea8559c2aa65207290a515804a97e702",
      "id": "hsk2-fltrp-2026:l12",
      "source": {
        "startPdfPage": 117,
        "endPdfPage": 126,
        "startPrintedPage": 102,
        "endPrintedPage": 111
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l12:text1",
          "audioTrack": "12-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l12:text1:line1",
              "zh": "喂，家月，是你啊！有什么事情吗？",
              "source": {
                "pdfPage": 118,
                "printedPage": 103,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text1:line2",
              "zh": "没什么事，就想跟您说说话。",
              "source": {
                "pdfPage": 118,
                "printedPage": 103,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text1:line3",
              "zh": "好啊。你今天没课吗？",
              "source": {
                "pdfPage": 118,
                "printedPage": 103,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text1:line4",
              "zh": "下午有课。您那里天气怎么样？",
              "source": {
                "pdfPage": 118,
                "printedPage": 103,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text1:line5",
              "zh": "北京这几天虽然是晴天，但是有点儿冷。",
              "source": {
                "pdfPage": 118,
                "printedPage": 103,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text1:line6",
              "zh": "我这里比北京冷多了，外边还正下着雪呢！",
              "source": {
                "pdfPage": 118,
                "printedPage": 103,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l12:text2",
          "audioTrack": "12-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l12:text2:line1",
              "zh": "喂，一飞，听家月说你那边下雪了，下得大不大？",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text2:line2",
              "zh": "今天不大，昨天比今天下得大。",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text2:line3",
              "zh": "天气不好，你去外面的时候多穿点儿衣服。",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text2:line4",
              "zh": "这几天我在网上上课，没出去过。",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text2:line5",
              "zh": "那就好，有事记得给我打电话。",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text2:line6",
              "zh": "好的。现在不下雪了，我出去买点儿吃的。",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text2:line7",
              "zh": "一次多买点儿，阴天下雪什么的就少出去吧。",
              "source": {
                "pdfPage": 120,
                "printedPage": 105,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l12:text3",
          "audioTrack": "12-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l12:text3:line1",
              "zh": "喂，家月，今天天气不错，我们去跑步吧！",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text3:line2",
              "zh": "你跑步跑得比我快，我们能一起跑吗？",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text3:line3",
              "zh": "可以的，我慢慢跑，等着你。",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text3:line4",
              "zh": "好吧。你真爱跑步啊！",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text3:line5",
              "zh": "我从小就经常跟爸爸跑步，跑步能让人快乐！",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text3:line6",
              "zh": "好，那我准备一下。",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l12:text3:line7",
              "zh": "我现在坐地铁去找你，一会儿楼下见。",
              "source": {
                "pdfPage": 122,
                "printedPage": 107,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l12:text4",
          "audioTrack": "12-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l12:text4:line1",
              "zh": "前几天天气不好，我没走路，每天坐两站地铁去学校。今天是个大晴天，李文让我跟他去外面跑步。他小时候经常跑步，跑得比我快，但是他会等我。跟李文一起跑步，我好高兴啊！",
              "source": {
                "pdfPage": 123,
                "printedPage": 108,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
