    {
      "file": "course-app/content/hsk2/lesson-08.json",
      "sha256": "90c7c19aac1d78ed62752356eefe09b6d3ee968c528c2008a53f0f2b1f96d00a",
      "id": "hsk2-fltrp-2026:l08",
      "source": {
        "startPdfPage": 79,
        "endPdfPage": 87,
        "startPrintedPage": 64,
        "endPrintedPage": 72
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l08:text1",
          "audioTrack": "8-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l08:text1:line1",
              "zh": "你看，这两块手表怎么样？",
              "source": {
                "pdfPage": 80,
                "printedPage": 65,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text1:line2",
              "zh": "都不错！",
              "source": {
                "pdfPage": 80,
                "printedPage": 65,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text1:line3",
              "zh": "我喜欢左边这个。",
              "source": {
                "pdfPage": 80,
                "printedPage": 65,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text1:line4",
              "zh": "我也觉得左边的比右边的好看。",
              "source": {
                "pdfPage": 80,
                "printedPage": 65,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text1:line5",
              "zh": "你看看要多少钱！",
              "source": {
                "pdfPage": 80,
                "printedPage": 65,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text1:line6",
              "zh": "真不便宜！八千八！",
              "source": {
                "pdfPage": 80,
                "printedPage": 65,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l08:text2",
          "audioTrack": "8-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l08:text2:line1",
              "zh": "今天有不少电影，我们看个电影吧。",
              "source": {
                "pdfPage": 82,
                "printedPage": 67,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text2:line2",
              "zh": "好啊！我们看哪个？",
              "source": {
                "pdfPage": 82,
                "printedPage": 67,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text2:line3",
              "zh": "我记得你喜欢看爱情片，我们看那个爱情片，怎么样？",
              "source": {
                "pdfPage": 82,
                "printedPage": 67,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text2:line4",
              "zh": "还是看这个吧，我看网上说这个电影比那个爱情片更有意思。",
              "source": {
                "pdfPage": 82,
                "printedPage": 67,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text2:line5",
              "zh": "好。我去买票。",
              "source": {
                "pdfPage": 82,
                "printedPage": 67,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text2:line6",
              "zh": "到网上买吧，网上买比在这里买便宜。",
              "source": {
                "pdfPage": 82,
                "printedPage": 67,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l08:text3",
          "audioTrack": "8-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l08:text3:line1",
              "zh": "您好！就要这几个菜吧，谢谢！",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text3:line2",
              "zh": "怎么点这么多菜？",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text3:line3",
              "zh": "你想想，今天是几月几号？",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text3:line4",
              "zh": "8月27号。啊！我的生日！",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text3:line5",
              "zh": "生日快乐！虽然你忘了，但是我记得。看看这是什么？",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text3:line6",
              "zh": "手表！吃饭、看电影、买手表，今天花了不少钱吧？",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l08:text3:line7",
              "zh": "虽然花了一些钱，但是我们过了一个快乐的生日。",
              "source": {
                "pdfPage": 84,
                "printedPage": 69,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l08:text4",
          "audioTrack": "8-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l08:text4:line1",
              "zh": "虽然妻子忘了今天是自己的生日，但是丈夫记得。丈夫请妻子去饭馆吃饭、去电影院看电影，还给妻子买了一块非常漂亮的手表。妻子觉得今天很快乐。",
              "source": {
                "pdfPage": 85,
                "printedPage": 70,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
      ],
