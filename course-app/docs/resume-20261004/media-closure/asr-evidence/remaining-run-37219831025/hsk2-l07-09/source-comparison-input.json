  "lessons": [
    {
      "file": "course-app/content/hsk2/lesson-07.json",
      "sha256": "15b9f36001307933da8120e66214e3b7a266640022f6953b67b174b2a9c78f4c",
      "id": "hsk2-fltrp-2026:l07",
      "source": {
        "startPdfPage": 71,
        "endPdfPage": 78,
        "startPrintedPage": 56,
        "endPrintedPage": 63
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l07:text1",
          "audioTrack": "7-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l07:text1:line1",
              "zh": "安妮，你是什么时候从北京回来的？",
              "source": {
                "pdfPage": 72,
                "printedPage": 57,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text1:line2",
              "zh": "昨天下午。天中，你怎么一下课就往外跑？",
              "source": {
                "pdfPage": 72,
                "printedPage": 57,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text1:line3",
              "zh": "我跟同学说好了，一起去打篮球。",
              "source": {
                "pdfPage": 72,
                "printedPage": 57,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text1:line4",
              "zh": "我也想跟你们一起玩。",
              "source": {
                "pdfPage": 72,
                "printedPage": 57,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text1:line5",
              "zh": "没问题，走吧。",
              "source": {
                "pdfPage": 72,
                "printedPage": 57,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l07:text2",
          "audioTrack": "7-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l07:text2:line1",
              "zh": "天中，你是不是很喜欢打篮球？",
              "source": {
                "pdfPage": 74,
                "printedPage": 59,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text2:line2",
              "zh": "没错。",
              "source": {
                "pdfPage": 74,
                "printedPage": 59,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text2:line3",
              "zh": "你还喜欢什么运动？",
              "source": {
                "pdfPage": 74,
                "printedPage": 59,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text2:line4",
              "zh": "我还喜欢踢足球，一到星期天就跟朋友们去踢球。",
              "source": {
                "pdfPage": 74,
                "printedPage": 59,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text2:line5",
              "zh": "你踢得怎么样？",
              "source": {
                "pdfPage": 74,
                "printedPage": 59,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text2:line6",
              "zh": "我踢得还可以。",
              "source": {
                "pdfPage": 74,
                "printedPage": 59,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l07:text3",
          "audioTrack": "7-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l07:text3:line1",
              "zh": "你篮球打得怎么样？",
              "source": {
                "pdfPage": 76,
                "printedPage": 61,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text3:line2",
              "zh": "打得还可以。",
              "source": {
                "pdfPage": 76,
                "printedPage": 61,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text3:line3",
              "zh": "跑步呢？你跑得快不快？",
              "source": {
                "pdfPage": 76,
                "printedPage": 61,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text3:line4",
              "zh": "我跑得不快，也不太喜欢跑步。",
              "source": {
                "pdfPage": 76,
                "printedPage": 61,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text3:line5",
              "zh": "那你喜欢游泳吗？",
              "source": {
                "pdfPage": 76,
                "printedPage": 61,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l07:text3:line6",
              "zh": "喜欢，但我游泳游得不快。",
              "source": {
                "pdfPage": 76,
                "printedPage": 61,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l07:text4",
          "audioTrack": "7-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l07:text4:line1",
              "zh": "我的爱好是运动。从上小学开始，我每天都跟爸爸去运动。现在我篮球打得很好，足球踢得不错，游泳游得也很快。我一有时间就去运动。",
              "source": {
                "pdfPage": 77,
                "printedPage": 62,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
      ],
