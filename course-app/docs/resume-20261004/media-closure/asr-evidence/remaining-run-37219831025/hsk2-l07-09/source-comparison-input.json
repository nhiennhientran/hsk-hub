    {
      "file": "course-app/content/hsk2/lesson-09.json",
      "sha256": "55675df1ef69682537b7137e4f2ba19e2a311cf7738969ecd790dae62cc885aa",
      "id": "hsk2-fltrp-2026:l09",
      "source": {
        "startPdfPage": 88,
        "endPdfPage": 98,
        "startPrintedPage": 73,
        "endPrintedPage": 83
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l09:text1",
          "audioTrack": "9-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l09:text1:line1",
              "zh": "儿子的裤子坏了，我们给他买条新的吧。",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text1:line2",
              "zh": "好啊。",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text1:line3",
              "zh": "你看这条黑色的怎么样？",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text1:line4",
              "zh": "没有你上次买的那条好看。",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text1:line5",
              "zh": "旁边那个男孩儿就穿了这样的裤子，我觉得很好看啊！",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text1:line6",
              "zh": "儿子的个子没有他那么高，穿上就不会太好看。",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text1:line7",
              "zh": "好吧，我们再去那边看看。",
              "source": {
                "pdfPage": 89,
                "printedPage": 74,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l09:text2",
          "audioTrack": "9-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l09:text2:line1",
              "zh": "门口有家奶茶店。你想喝杯奶茶吗？",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text2:line2",
              "zh": "我想喝咖啡，还是去咖啡店吧。",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text2:line3",
              "zh": "咖啡店离这儿有点儿远。",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text2:line4",
              "zh": "没关系，那家店的咖啡很好喝。",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text2:line5",
              "zh": "那你等一下，我去买杯奶茶。",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text2:line6",
              "zh": "你不想喝咖啡吗？",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text2:line7",
              "zh": "喝了咖啡，晚上就别想睡觉了。",
              "source": {
                "pdfPage": 91,
                "printedPage": 76,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l09:text3",
          "audioTrack": "9-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l09:text3:line1",
              "zh": "我们打车回去吧。",
              "source": {
                "pdfPage": 93,
                "printedPage": 78,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text3:line2",
              "zh": "这里离家很近，还是走路吧。",
              "source": {
                "pdfPage": 93,
                "printedPage": 78,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text3:line3",
              "zh": "要走多长时间？",
              "source": {
                "pdfPage": 93,
                "printedPage": 78,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text3:line4",
              "zh": "走半个多小时就到了。",
              "source": {
                "pdfPage": 93,
                "printedPage": 78,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l09:text3:line5",
              "zh": "好的。每天上下班都坐车，今天运动运动吧。",
              "source": {
                "pdfPage": 93,
                "printedPage": 78,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l09:text4",
          "audioTrack": "9-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l09:text4:line1",
              "zh": "这周刘明休息，我下班后跟他去了一家商店。商店里边的衣服没有大商场里的好看。我们没有买到喜欢的衣服，从商店出来就到咖啡店坐了坐。因为想运动运动，所以喝完东西，我们就走回家了。",
              "source": {
                "pdfPage": 95,
                "printedPage": 80,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
