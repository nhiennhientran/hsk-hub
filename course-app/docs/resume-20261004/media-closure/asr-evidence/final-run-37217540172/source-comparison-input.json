    {
      "file": "course-app/content/hsk2/lesson-06.json",
      "sha256": "c6302d84d74ea51a02c1afaaaff781b7513350d6516608d73e5edd084bb06b20",
      "id": "hsk2-fltrp-2026:l06",
      "source": {
        "startPdfPage": 61,
        "endPdfPage": 70,
        "startPrintedPage": 46,
        "endPrintedPage": 55
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l06:text1",
          "audioTrack": "6-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l06:text1:line1",
              "zh": "明天就是女儿的生日了。",
              "source": {
                "pdfPage": 62,
                "printedPage": 47,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text1:line2",
              "zh": "你不说，我还真忘了。我们给她准备个什么礼物呢？",
              "source": {
                "pdfPage": 62,
                "printedPage": 47,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text1:line3",
              "zh": "她喜欢画画，你觉得画笔怎么样？",
              "source": {
                "pdfPage": 62,
                "printedPage": 47,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text1:line4",
              "zh": "就送画笔吧！",
              "source": {
                "pdfPage": 62,
                "printedPage": 47,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text1:line5",
              "zh": "那我明天上午就去买。",
              "source": {
                "pdfPage": 62,
                "printedPage": 47,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text1:line6",
              "zh": "好的！我再给她买个大大的生日蛋糕。",
              "source": {
                "pdfPage": 62,
                "printedPage": 47,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l06:text2",
          "audioTrack": "6-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l06:text2:line1",
              "zh": "小雪，生日快乐！",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line2",
              "zh": "姐姐，生日快乐！",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line3",
              "zh": "小雪，这是爸爸、妈妈送你的礼物。",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line4",
              "zh": "你打开看看喜欢不喜欢。",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line5",
              "zh": "画笔！我很喜欢！",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line6",
              "zh": "那你想画点儿什么？",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line7",
              "zh": "画我们的家！有爸爸、妈妈、弟弟，还有黑色的狗、白色的猫什么的。",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text2:line8",
              "zh": "那我要画一个穿白色衣服的姐姐。",
              "source": {
                "pdfPage": 64,
                "printedPage": 49,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l06:text3",
          "audioTrack": "6-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l06:text3:line1",
              "zh": "小雪，看看今天有什么好吃的。",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text3:line2",
              "zh": "长长的面条儿，大大的蛋糕。",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text3:line3",
              "zh": "你看，还有鱼啊肉啊什么的，都是你喜欢吃的。",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text3:line4",
              "zh": "谢谢爸爸、妈妈！",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text3:line5",
              "zh": "快去叫弟弟过来吃饭吧，吃完饭我们还要出去玩呢。",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text3:line6",
              "zh": "过生日真好啊！",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l06:text3:line7",
              "zh": "是的，过生日就要吃好吃的，还要高高兴兴地玩。",
              "source": {
                "pdfPage": 66,
                "printedPage": 51,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l06:text4",
          "audioTrack": "6-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l06:text4:line1",
              "zh": "今天是女儿的生日。我们买了蛋糕，做了面条儿，还做了鱼啊肉啊什么的。吃完晚饭，一家人去看了个电影。回家后，孩子们早早地就上床了。明天不上学，他们说要舒舒服服地睡一觉，让我们晚点儿叫他们起床。这是很忙、很累，但很快乐的一天。",
              "source": {
                "pdfPage": 67,
                "printedPage": 52,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
