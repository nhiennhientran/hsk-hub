  "lessons": [
    {
      "file": "course-app/content/hsk2/lesson-04.json",
      "sha256": "cc303bdf9b9498ad2745ab055b5a0b7b397723d92467c50a4ed26beb40c44e8c",
      "id": "hsk2-fltrp-2026:l04",
      "source": {
        "startPdfPage": 44,
        "endPdfPage": 51,
        "startPrintedPage": 29,
        "endPrintedPage": 36
      },
      "texts": [
        {
          "id": "hsk2-fltrp-2026:l04:text1",
          "audioTrack": "4-1",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l04:text1:line1",
              "zh": "妈妈，我们来过这家商场吗？",
              "source": {
                "pdfPage": 45,
                "printedPage": 30,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text1:line2",
              "zh": "没来过，这是新开的。",
              "source": {
                "pdfPage": 45,
                "printedPage": 30,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text1:line3",
              "zh": "我们进去看看吧。",
              "source": {
                "pdfPage": 45,
                "printedPage": 30,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text1:line4",
              "zh": "好啊！你想买点儿什么？",
              "source": {
                "pdfPage": 45,
                "printedPage": 30,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text1:line5",
              "zh": "我想买条裤子。",
              "source": {
                "pdfPage": 45,
                "printedPage": 30,
                "section": "课文1",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text1:line6",
              "zh": "没问题。",
              "source": {
                "pdfPage": 45,
                "printedPage": 30,
                "section": "课文1",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l04:text2",
          "audioTrack": "4-3",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l04:text2:line1",
              "zh": "妈妈，我想买这条白色的裤子。",
              "source": {
                "pdfPage": 47,
                "printedPage": 32,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text2:line2",
              "zh": "你有很多白色的衣服，为什么还买白色的？",
              "source": {
                "pdfPage": 47,
                "printedPage": 32,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text2:line3",
              "zh": "因为我喜欢白色啊！",
              "source": {
                "pdfPage": 47,
                "printedPage": 32,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text2:line4",
              "zh": "我觉得这条白色的不太好看，你试试那条红色的吧。",
              "source": {
                "pdfPage": 47,
                "printedPage": 32,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text2:line5",
              "zh": "我没穿过红色的，红色的好看吗？",
              "source": {
                "pdfPage": 47,
                "printedPage": 32,
                "section": "课文2",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text2:line6",
              "zh": "就是因为没穿过，所以要试试啊！",
              "source": {
                "pdfPage": 47,
                "printedPage": 32,
                "section": "课文2",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l04:text3",
          "audioTrack": "4-5",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l04:text3:line1",
              "zh": "妈妈，我想买个新书包。",
              "source": {
                "pdfPage": 48,
                "printedPage": 33,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text3:line2",
              "zh": "好，那边卖书包，我们过去看看吧。",
              "source": {
                "pdfPage": 48,
                "printedPage": 33,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text3:line3",
              "zh": "这么多漂亮的书包！",
              "source": {
                "pdfPage": 48,
                "printedPage": 33,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text3:line4",
              "zh": "红色的、绿色的、黑色的，你想买哪个？",
              "source": {
                "pdfPage": 48,
                "printedPage": 33,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text3:line5",
              "zh": "绿色的吧。",
              "source": {
                "pdfPage": 48,
                "printedPage": 33,
                "section": "课文3",
                "provenance": "textbook"
              }
            },
            {
              "id": "hsk2-fltrp-2026:l04:text3:line6",
              "zh": "不错，我也觉得绿色的更好看。",
              "source": {
                "pdfPage": 48,
                "printedPage": 33,
                "section": "课文3",
                "provenance": "textbook"
              }
            }
          ]
        },
        {
          "id": "hsk2-fltrp-2026:l04:text4",
          "audioTrack": "4-7",
          "lines": [
            {
              "id": "hsk2-fltrp-2026:l04:text4:line1",
              "zh": "我和妈妈去了一家商场。因为是新开的，所以这几天东西很便宜。商场里的衣服颜色很多。我没穿过红色的裤子，妈妈让我试了试，我觉得我穿红色的也很好看。",
              "source": {
                "pdfPage": 50,
                "printedPage": 35,
                "section": "课文4",
                "provenance": "textbook"
              }
            }
          ]
        }
      ],
