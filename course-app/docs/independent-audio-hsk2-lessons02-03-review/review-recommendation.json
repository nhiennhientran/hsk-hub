      "sourceHash": "6d065977c6e53de14a9c542ccc007b05513607d1ddf915eb8ddab89761ac31e3",
      "start": 5.017,
      "end": 7.831,
      "sourceText": "有，但车站有点儿远。",
      "sourcePinyin": "Yǒu, dàn chēzhàn yǒudiǎnr yuǎn."
    },
    {
      "id": "hsk2-fltrp-2026:l02:text1:line3",
      "kind": "lines",
      "track": "course-assets/hsk2/audio/2-1.mp3",
      "sourceHash": "6d065977c6e53de14a9c542ccc007b05513607d1ddf915eb8ddab89761ac31e3",
      "start": 8.729,
      "end": 10.296,
      "sourceText": "这儿好打车吗？",
      "sourcePinyin": "Zhèr hǎo dǎchē ma?"
    },
    {
      "id": "hsk2-fltrp-2026:l02:text1:line4",
      "kind": "lines",
      "track": "course-assets/hsk2/audio/2-1.mp3",
      "sourceHash": "6d065977c6e53de14a9c542ccc007b05513607d1ddf915eb8ddab89761ac31e3",
      "start": 11.057,
      "end": 12.073,
      "sourceText": "好打车。",
