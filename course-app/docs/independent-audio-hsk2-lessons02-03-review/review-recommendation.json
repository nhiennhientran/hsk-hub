      "start": 17.5,
      "end": 19.208,
      "sourceText": "好，没问题。",
      "sourcePinyin": "Hǎo, méi wèntí."
    },
    {
      "id": "hsk2-fltrp-2026:l02:text2:line1",
      "kind": "lines",
      "track": "course-assets/hsk2/audio/2-3.mp3",
