{
  "name": "hsk1-modular-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "catalog:generate": "node tools/catalog.mjs --write",
    "catalog:check": "node tools/catalog.mjs --check",
    "check": "tsc --noEmit",
    "test": "node tools/run-checkpoint.mjs unit",
    "index:generate": "node tools/course-index.mjs --write",
    "index:check": "node tools/course-index.mjs",
    "test:legacy": "node tools/test-legacy.mjs",
    "test:repro": "node tools/reproduce-init.mjs",
    "test:smoke": "node tools/run-checkpoint.mjs browser",
    "build": "npm run index:check && npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "fixtures:generate": "node tools/migration-fixtures.mjs --write",
    "fixtures:check": "node tools/migration-fixtures.mjs --check",
    "assets:check": "node tools/check-course-assets.mjs",
    "student:check": "node tools/check-student-build.mjs",
    "release:manifest": "node tools/release-manifest.mjs",
    "test:release": "node tools/run-checkpoint.mjs browser --config=playwright.release.config.ts",
    "build:release": "npm run build && node tools/check-student-build.mjs --private && node tools/prepare-public-dist.mjs && npm run student:check && npm run assets:check && npm run release:manifest && node tools/test-release-architecture.mjs",
    "public:check": "node tools/prepare-public-dist.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
